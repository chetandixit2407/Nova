{
  "name": "nova-notch",
  "productName": "NOVA NOTCH",
  "private": true,
  "version": "1.0.2",
  "description": "A premium Dynamic Island-style smart notch for Windows, bringing live activities, media controls, system insights and quick actions into one elegant desktop interface.",
  "author": {
    "name": "Chetan Dixit",
    "email": "chetandixit9968@gmail.com"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "CI=true tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "electron:start": "electron .",
    "electron:pack": "npm run build && electron-builder --dir --config electron-builder.json",
    "electron:build": "npm run build && electron-builder --win nsis --config electron-builder.json",
    "electron:msix": "npm run build && electron-builder --win appx --x64 --arm64 --publish never --config electron-builder.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
