<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:iot="http://schemas.microsoft.com/appx/manifest/iot/windows10"
  IgnorableNamespaces="uap rescap desktop desktop4 iot">

  <Identity
    Name="ChetanDixit.NOVANOTCH"
    Publisher="CN=1635A490-94F8-403E-9B36-79A1AE02E253"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>NOVA — Windows Smart Notch</DisplayName>
    <PublisherDisplayName>Chetan Dixit</PublisherDisplayName>
    <Logo>icons\StoreLogo.png</Logo>
    <Description>Premium Dynamic Island and Smart Notch for Windows desktop with live activities, media visualizer, AI Hub, and fluent controls.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="NOVAApp"
      Executable="nova.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="NOVA"
        Description="NOVA — Windows Smart Notch &amp; Dynamic Island"
        BackgroundColor="#090D16"
        Square150x150Logo="icons\Square150x150Logo.png"
        Square44x44Logo="icons\Square44x44Logo.png">

        <uap:DefaultTile
          Wide310x150Logo="icons\Wide310x150Logo.png"
          ShortName="NOVA">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>

        <uap:SplashScreen Image="icons\Wide310x150Logo.png" BackgroundColor="#000000" />
      </uap:VisualElements>

      <Extensions>
        <!-- Start with Windows (Startup Task) -->
        <desktop:Extension Category="windows.startupTask" Executable="nova.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="NOVAStartupTask"
            Enabled="true"
            DisplayName="NOVA Dynamic Island Background Service" />
        </desktop:Extension>

        <!-- Native Protocol Handler for quick launch -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="nova">
            <uap:DisplayName>NOVA Notch Launch Protocol</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Standard Desktop Bridge capabilities compliant with Windows App Certification Kit (WACK) -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
